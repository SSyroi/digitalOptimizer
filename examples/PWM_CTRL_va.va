      cnt_1_q = vlow;
      cnt_2_q = vlow;
      cnt_3_q = vlow;
    end

    // Sequential Register Bank Clock Edge Sampling
    @(cross(V(clk) - vth, +1)) begin
      cnt_0_q = (cnt_0_d > vth) ? vhigh : vlow;
      cnt_1_q = (cnt_1_d > vth) ? vhigh : vlow;
