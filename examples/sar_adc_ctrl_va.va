    // D-input for DFF state[1]:
    state_1_d = NAND3(INV(state_1_q), NAND2(V(start), INV(state_2_q)), NAND2(state_0_q, INV(state_2_q)));
    // D-input for DFF state[2]:
    state_2_d = NAND3(INV(state_0_q), INV(state_1_q), NAND2(V(start), INV(state_2_q)));
    // D-input for DFF dac_reg[0]:
    dac_reg_0_d = OR2(OR2(AND2(dac_reg_0_q, state_0_q), OR2(AND2(dac_reg_0_q, state_1_q), AND2(dac_reg_0_q, INV(state_2_q)))), OR2(AND3(state_0_q, state_1_q, INV(state_2_q)), OR2(AND2(AND2(V(comp_out), state_2_q), AND2(INV(state_0_q), INV(state_1_q))), AND2(AND2(V(start), INV(state_0_q)), AND2(INV(state_1_q), INV(state_2_q))))));
    // D-input for DFF dac_reg[1]:
    dac_reg_1_d = OR2(OR2(AND2(dac_reg_1_q, state_2_q), AND2(dac_reg_1_q, INV(state_1_q))), OR2(AND3(V(comp_out), state_1_q, INV(state_2_q)), OR2(AND3(V(start), INV(state_0_q), INV(state_2_q)), AND3(state_1_q, INV(state_0_q), INV(state_2_q)))));
    // D-input for DFF dac_reg[2]:
    dac_reg_2_d = OR2(OR2(AND2(dac_reg_2_q, state_0_q), OR2(AND2(dac_reg_2_q, state_2_q), AND2(dac_reg_2_q, INV(state_1_q)))), OR2(AND3(V(start), INV(state_1_q), INV(state_2_q)), OR2(AND3(state_0_q, INV(state_1_q), INV(state_2_q)), AND2(AND2(V(comp_out), state_1_q), AND2(INV(state_0_q), INV(state_2_q))))));
    // D-input for DFF dac_reg[3]:
