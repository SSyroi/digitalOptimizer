    cnt_3_d         = NAND4(w_c20, w_c21, w_c22, w_c23);
    cnt_2_d         = NAND3(w_c24, w_c25, w_c26);
    cnt_1_d         = NAND2(w_c27, w_c28);
    cnt_0_d         = INV(w_c29);
    startup_d       = NAND4(w_c30, w_c31, w_c32, w_c33);
    en_LP_d         = NAND2(INV(NAND4(w_c34, w_c35, w_c36, w_c37)), INV(INV(w_c38)));
    oc_ctrl_bgr_d   = NAND2(INV(NAND4(INV(NAND4(w_c39, w_c40, w_c41, w_c19)), INV(NAND4(w_c12, w_c13, w_c42, w_c43)), INV(NAND4(w_c14, w_c44, w_c45, w_c15)), INV(NAND4(w_c3, w_c16, w_c46, w_c17)))), INV(NAND2(INV(NAND4(w_c4, w_c18, w_c47, w_c48)), INV(NAND4(w_c49, w_c50, w_c51, w_c52)))));

    // Analog Electrical Output Drivers
    V(en_LP)           <+ transition((en_LP_q > 0.5) ? V(VDD) : V(VSS), tdel, trise, tfall);
    V(oc_select)       <+ transition((oc_select_val > 0.5) ? V(VDD) : V(VSS), tdel, trise, tfall);
    V(oc_ctrl_cp)      <+ transition((oc_ctrl_cp_val > 0.5) ? V(VDD) : V(VSS), tdel, trise, tfall);
    V(oc_ctrl_bgr)     <+ transition((oc_ctrl_bgr_q > 0.5) ? V(VDD) : V(VSS), tdel, trise, tfall);
    V(en_lowFreq)      <+ transition((en_lowFreq_val > 0.5) ? V(VDD) : V(VSS), tdel, trise, tfall);
    V(oc_select_ext)   <+ transition((oc_select_val > 0.5) ? V(VDD) : V(VSS), tdel, trise, tfall);
    V(oc_ctrl_cp_ext)  <+ transition((oc_ctrl_cp_val > 0.5) ? V(VDD) : V(VSS), tdel, trise, tfall);
    V(en_LP_ext)       <+ transition((en_LP_q > 0.5) ? V(VDD) : V(VSS), tdel, trise, tfall);
  end
endmodule
