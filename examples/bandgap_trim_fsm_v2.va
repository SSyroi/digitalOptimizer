  real trim_reg_2_d;
  real trim_code_0_val;
  real trim_code_1_val;
  real trim_code_2_val;
  real trim_done_val;

  // ===========================================================================
  // Analog Behavioral Block
  // ===========================================================================
  analog begin
    // -------------------------------------------------------------------------
    // 1. Initial Step: DC Operating Point State Initialization
    // -------------------------------------------------------------------------
    @(initial_step("static", "ac")) begin
      done_reg_q = 0.0;
      trim_reg_0_q = 0.0;
      trim_reg_1_q = 0.0;
      trim_reg_2_q = 0.0;
    end

    // -------------------------------------------------------------------------
    // 2. Sequential Clock Cross Event (Register Updates)
    // -------------------------------------------------------------------------
    @(cross(V(clk) - vth, 1, vtol, ttol)) begin
      if (V(rst_n) < vth) begin
        done_reg_q = 0.0;
        trim_reg_0_q = 0.0;
        trim_reg_1_q = 0.0;
        trim_reg_2_q = 0.0;
      end else begin
        done_reg_q = done_reg_d;
        trim_reg_0_q = trim_reg_0_d;
        trim_reg_1_q = trim_reg_1_d;
        trim_reg_2_q = trim_reg_2_d;
      end
