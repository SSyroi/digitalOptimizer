    // -------------------------------------------------------------------------
    // 3. Combinational Logic Cones (Simplified & Tech-Mapped)
    // -------------------------------------------------------------------------
    // D-input for DFF done_reg:
    done_reg_d = NAND2(NAND2(V(start_trim), V(comp_high)), done_reg_q);
    // D-input for DFF trim_reg[0]:
    trim_reg_0_d = NAND4(NAND2(V(comp_high), trim_reg_0_q), NAND2(INV(V(start_trim)), trim_reg_0_q), NAND2(done_reg_q, trim_reg_0_q), NAND4(V(start_trim), INV(V(comp_high)), INV(done_reg_q), INV(trim_reg_0_q)));
    // D-input for DFF trim_reg[1]:
    trim_reg_1_d = NAND2(NAND2(NAND2(INV(trim_reg_0_q), trim_reg_1_q), NAND2(INV(V(start_trim)), trim_reg_1_q)), NAND3(NAND2(V(comp_high), trim_reg_1_q), AND2(AND2(V(start_trim), INV(V(comp_high))), AND2(INV(done_reg_q), AND2(trim_reg_0_q, INV(trim_reg_1_q)))), NAND2(done_reg_q, trim_reg_1_q)));
    // D-input for DFF trim_reg[2]:
    trim_reg_2_d = NAND2(NAND3(AND2(AND2(V(start_trim), AND2(INV(V(comp_high)), INV(done_reg_q))), AND2(trim_reg_0_q, AND2(trim_reg_1_q, INV(trim_reg_2_q)))), NAND2(done_reg_q, trim_reg_2_q), NAND2(INV(trim_reg_0_q), trim_reg_2_q)), NAND3(NAND2(INV(trim_reg_1_q), trim_reg_2_q), NAND2(INV(V(start_trim)), trim_reg_2_q), NAND2(V(comp_high), trim_reg_2_q)));
    // Output trim_code[0]:
    trim_code_0_val = trim_reg_0_q;
    // Output trim_code[1]:
    trim_code_1_val = trim_reg_1_q;
    // Output trim_code[2]:
    trim_code_2_val = trim_reg_2_q;
    // Output trim_done:
    trim_done_val = done_reg_q;

    // -------------------------------------------------------------------------
    // 4. Analog Output Drivers (Continuous Transition Filters)
    // -------------------------------------------------------------------------
    V(trim_code[0]) <+ transition(trim_code_0_val * vdd, tdel, trise, tfall);
    V(trim_code[1]) <+ transition(trim_code_1_val * vdd, tdel, trise, tfall);
    V(trim_code[2]) <+ transition(trim_code_2_val * vdd, tdel, trise, tfall);
    V(trim_done) <+ transition(trim_done_val * vdd, tdel, trise, tfall);
  end

endmodule